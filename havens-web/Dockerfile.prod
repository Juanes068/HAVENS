# ─── Stage 1: Build ──────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Accept build-time environment variables for Vite
ARG VITE_API_URL
ARG VITE_GOOGLE_MAPS_API_KEY
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_GOOGLE_MAPS_API_KEY=$VITE_GOOGLE_MAPS_API_KEY

# Install dependencies (cached layer)
COPY package.json package-lock.json* yarn.lock* ./
RUN npm install --frozen-lockfile || npm install

# Copy source and build
COPY . .
RUN npm run build

# ─── Stage 2: Serve with Nginx ───────────────────────────────────────────────
# The built files are stored in /app/dist
# In production, docker-compose.prod.yml mounts these into Nginx directly.
# This stage is just a minimal image that holds the /app/dist output.
FROM alpine:3.19
WORKDIR /app
COPY --from=builder /app/dist ./dist
