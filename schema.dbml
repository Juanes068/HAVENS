// =============================================================================
// HAVENS PLATFORM - DATABASE SCHEMA (DBML)
// Production Schema for Django Backend + MySQL Database
// Compatible with dbdiagram.io
// =============================================================================

// 1. communities (White-label branding & localized circles)
table communities {
  id int [pk, increment]
  name varchar(255) [not null]
  subdomain varchar(100) [unique, null] // Opcional en el MVP, se mantiene por arquitectura
  description text [null]
  logo_url varchar(500) [null]
  primary_color varchar(50) [default: '#2D5A3D']
  secondary_color varchar(50) [default: '#FAF8F5']
  creator_id int [ref: > users.id, null]
  created_at datetime [default: `now()`]
}

// 2. users (Base de autenticación de Django auth_user)
table users {
  id int [pk, increment]
  username varchar(150) [unique, not null] // Clave para tokenAuth de JWT
  email varchar(254) [unique, not null]
  password_hash varchar(128) [not null]
  is_active boolean [default: true]
  is_staff boolean [default: false]
  date_joined datetime [default: `now()`]
  last_login datetime [null]
}

// 2.1 user_profiles (OneToOne con users - Perfil, Gamificación y Geolocalización)
table user_profiles {
  id int [pk, increment]
  user_id int [unique, not null, ref: - users.id] // OneToOne
  community_id int [ref: > communities.id, null] // Círculo principal opcional
  bio text [null]
  neighbourhood varchar(255) [null]
  city_name varchar(100) [null] // 'Bogotá', 'Vancouver', etc.
  latitude float [null] // Para cálculo de proximidad Haversine
  longitude float [null]
  date_of_birth date [null]
  age int [null]
  photo_url varchar(500) [null] // URL de Cloudinary o S3
  total_points int [default: 0] // Gamificación y recompensas
  trust_score decimal(4, 2) [default: 5.00] // Algoritmo de reputación y confianza
  invite_code varchar(32) [null] // Código de invitación dinámico
  created_at datetime [default: `now()`]
  updated_at datetime [default: `now()`]
}

// 3. friendships (El core de "Friends-First" / Conexiones directas)
table friendships {
  id int [pk, increment]
  user_id int [not null, ref: > users.id]
  friend_id int [not null, ref: > users.id]
  status varchar(20) [not null, default: 'pending'] // 'pending', 'accepted', 'declined'
  created_at datetime [default: `now()`]

  indexes {
    (user_id, friend_id) [unique]
  }
}

// 4. hobby_categories & hobbies (Taxonomía de Intereses y Pasiones)
table hobby_categories {
  id int [pk, increment]
  name varchar(100) [unique, not null] // 'Outdoors', 'Wellness', 'Food & Drink', etc.
  icon varchar(50) [null]
  description text [null]
}

table hobbies {
  id int [pk, increment]
  category_id int [not null, ref: > hobby_categories.id]
  name varchar(100) [not null]
  slug varchar(100) [unique, null]
}

table user_hobbies {
  user_profile_id int [not null, ref: > user_profiles.id]
  hobby_id int [not null, ref: > hobbies.id]
  
  indexes {
    (user_profile_id, hobby_id) [pk]
  }
}

// 5. matches (Conexiones curadas del sistema por afinidad)
table matches {
  id int [pk, increment]
  community_id int [ref: > communities.id, null]
  user_one_id int [not null, ref: > users.id]
  user_two_id int [not null, ref: > users.id]
  status varchar(20) [not null, default: 'pending'] // 'pending', 'accepted', 'rejected', 'ignored'
  affinity_score int [default: 0] // Puntuación de afinidad calculada
  created_at datetime [default: `now()`]
  updated_at datetime [default: `now()`]

  indexes {
    (user_one_id, user_two_id) [unique]
  }
}

// 6. chats and messaging (Mensajería 1-a-1 y salas de grupo de comunidad)
table messages {
  id int [pk, increment]
  match_id int [ref: > matches.id, null] // Valida permisos a nivel de match
  community_id int [ref: > communities.id, null] // Valida permisos a nivel de circle chat
  sender_id int [not null, ref: > users.id]
  content text [not null]
  is_read boolean [default: false]
  created_at datetime [default: `now()`]
}

// 7. events (El centro del descubrimiento y planes comunitarios)
table events {
  id int [pk, increment]
  community_id int [ref: > communities.id, null]
  creator_id int [not null, ref: > users.id] 
  title varchar(200) [not null]
  description text [null]
  location_name varchar(300) [null]
  latitude float [not null] // Requerido para filtro esférico Haversine
  longitude float [not null]
  max_attendees int [null] // Mantiene la esencia de grupos pequeños
  min_age int [null]
  max_age int [null]
  age_range varchar(100) [default: 'All Ages']
  visibility varchar(30) [not null, default: 'public'] // 'public', 'community_only', 'friends_only', 'private'
  image_url varchar(500) [null]
  points_reward int [default: 10]
  scheduled_date datetime [not null, default: `now()`] // UTC wall-clock unificado
  created_at datetime [default: `now()`]
}

table event_hobbies {
  event_id int [not null, ref: > events.id]
  hobby_id int [not null, ref: > hobbies.id]

  indexes {
    (event_id, hobby_id) [pk]
  }
}

// 7.1 event_swipes (Lógica de Tinder de Eventos - Swipe Feed)
table event_swipes {
  id int [pk, increment]
  user_id int [not null, ref: > users.id]
  event_id int [not null, ref: > events.id]
  response varchar(20) [not null] // 'like', 'pass', 'going', 'maybe'
  created_at datetime [default: `now()`]

  indexes {
    (user_id, event_id) [unique]
  }
}

// 7.2 event_rsvps (Asistencias confirmadas y listas de invitados)
table event_rsvps {
  id int [pk, increment]
  event_id int [not null, ref: > events.id]
  user_id int [not null, ref: > users.id]
  response varchar(20) [not null, default: 'going'] // 'going', 'maybe', 'pass'
  created_at datetime [default: `now()`]
  updated_at datetime [default: `now()`]
  
  indexes {
    (event_id, user_id) [unique]
  }
}

// 7.3 tickets (Tickets de acceso / verificación)
table tickets {
  id int [pk, increment]
  event_id int [not null, ref: > events.id]
  user_id int [not null, ref: > users.id]
  ticket_code varchar(64) [unique, not null]
  status varchar(20) [default: 'valid'] // 'valid', 'used', 'cancelled'
  created_at datetime [default: `now()`]
}

// 8. subscriptions and payments (Monetización)
table subscriptions {
  id int [pk, increment]
  user_id int [not null, ref: > users.id]
  plan_name varchar(100) [not null]
  gateway_subscription_id varchar(255) [null]
  status varchar(50) [not null, default: 'active'] // 'active', 'cancelled', 'past_due'
  current_period_end datetime [null]
  created_at datetime [default: `now()`]
}

table payments {
  id int [pk, increment]
  user_id int [not null, ref: > users.id]
  subscription_id int [ref: > subscriptions.id, null]
  amount decimal(10, 2) [not null]
  payment_status varchar(50) [not null] // 'succeeded', 'pending', 'failed'
  payment_date datetime [default: `now()`]
}
